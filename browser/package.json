{
  "name": "terminal-browser",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "node node_modules/terminal-electron/scripts/postinstall.mjs && bash ../scripts/copy-react-grab.sh",
    "build": "tsc -p tsconfig.json",
    "start": "pnpm build && pnpm --filter terminal-browser-cli build && exec node ../cli/dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "pixel-store": "workspace:*",
    "react": "^18.3.1",
    "react-grab": "0.2.0",
    "terminal-electron": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "electron": "43.3.0",
    "typescript": "^5.5.0"
  }
}
